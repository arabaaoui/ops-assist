# Copy to .env and fill in. Never commit .env.
OPS_ASSIST_PROFILE=local          # local, gemini, api, openai, anthropic, mistral, openrouter, mixed or gateway
# OPS_ASSIST_MODELS=ollama_chat/qwen3:8b   # comma-separated LiteLLM ids, first = primary
# OPS_ASSIST_API_BASE=http://localhost:11434
# OPS_ASSIST_INCIDENT=payment-latency
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Gateway profile: OPS_ASSIST_PROFILE=gateway; default URL below, virtual key in OPENAI_API_KEY
# OPS_ASSIST_API_BASE=http://127.0.0.1:4000/v1
# OPENAI_API_KEY=
# OPS_ASSIST_SOURCE=replay
# OPS_ASSIST_PROMETHEUS_URL=  # required for live source
# OPS_ASSIST_LOKI_URL=  # required for live source
# OPS_ASSIST_CHANGES_FILE=  # no live changes file by default
# OPS_ASSIST_HTTP_TIMEOUT=5
# OPS_ASSIST_TOOL_TIMEOUT=10
# OPS_ASSIST_TOOLS=inprocess
# OPS_ASSIST_TOPOLOGY=single
# OPS_ASSIST_ALLOW_WRITES=0
# OPS_ASSIST_STATE_DIR=~/.local/state/ops-assist
# OPS_ASSIST_AUDIT_FILE=audit.jsonl
# OPS_ASSIST_MAX_TOOL_CALLS=100
# OPS_ASSIST_MAX_DELEGATIONS=10
# OPS_ASSIST_A2A_TOKEN=  # no authentication by default
# OPS_ASSIST_A2A_TIMEOUT=120
# OPS_ASSIST_A2A_CARD_URL=http://127.0.0.1:8000/.well-known/agent-card.json
# OPS_ASSIST_SESSION_DB=  # in-memory sessions by default
# OPS_ASSIST_MEMORY_DIR=~/.local/state/ops-assist
# OPS_ASSIST_INCIDENTS_DIR=  # bundled incidents by default
# OPS_ASSIST_PROFILES_FILE=  # bundled profiles by default
# OPS_ASSIST_EMBEDDINGS=hash  # or a LiteLLM embedding model id
# OPS_ASSIST_EMBEDDINGS_API_BASE=http://localhost:11434
# OPS_ASSIST_INDEX_FILE=knowledge-index.json  # index and incremental manifest inside OPS_ASSIST_STATE_DIR
